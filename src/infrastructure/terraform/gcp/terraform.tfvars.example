project_id   = "your-gcp-project-id"
region       = "europe-west3"
service_name = "causal-backend"

# Full image ref passed by CI later.
container_image = "europe-west3-docker.pkg.dev/your-gcp-project-id/backend-images/backend:dev"

artifact_registry_repository_id = "backend-images"

data_bucket_name   = "your-gcp-project-id-data"
models_bucket_name = "your-gcp-project-id-models"

# Set true only if you really want terraform destroy to delete non-empty buckets.
data_bucket_force_destroy   = false
models_bucket_force_destroy = false

firebase_database_region = "europe-west1"

# DEFAULT_DATABASE is the usual one, but note the destroy caveat.
# USER_DATABASE is more lifecycle-friendly, but non-default/user DBs require Blaze/billing.
firebase_database_type = "DEFAULT_DATABASE"

runtime_service_account_id = "cloud-run-backend"

cpu            = "1"
memory         = "2Gi"
concurrency    = 10
timeout_seconds = 300
min_instances  = 0
max_instances  = 3

container_port        = 8080
allow_unauthenticated = false
deletion_protection   = false

langfuse_base_url = "https://cloud.langfuse.com"
langfuse_debug    = "False"

gcs_models_timeout_seconds              = 60
gcs_models_upload_timeout_seconds       = 300
gcs_models_upload_retry_timeout_seconds = 900
gcs_models_upload_chunk_size_bytes      = 8388608

extra_plain_env_vars = {
  APP_ENV = "prod"
}

# Existing Secret Manager secrets only. Terraform will not create them here.
secret_env_vars = {
  GEMINI_API_KEY = {
    secret_id = "gemini-api-key"
    version   = "latest"
  }
  LANGFUSE_SECRET_KEY = {
    secret_id = "langfuse-secret-key"
    version   = "latest"
  }
  LANGFUSE_PUBLIC_KEY = {
    secret_id = "langfuse-public-key"
    version   = "latest"
  }
}

# Intentionally empty by default.
# Add only what your runtime actually needs.
runtime_extra_project_roles = []
# Example, only if your app truly needs broad Firebase Admin SDK access:
# runtime_extra_project_roles = ["roles/editor"]

labels = {
  app = "causal-backend"
  env = "prod"
}