project_id = "your-gcp-project-dev"
region     = "europe-west3"

# One of: dev, prod, feature
environment = "dev"
name_prefix = "causal"

# Required only when environment = "feature"
feature_slug = ""

# Full image ref passed by CI/CD.
container_image = "europe-west3-docker.pkg.dev/your-gcp-project-dev/causal-dev-images/backend:dev"

firebase_database_region = "europe-west1"
firebase_database_type   = "DEFAULT_DATABASE"

vertex_ai_project_id = "your-gcp-project-dev"
vertex_ai_location   = "us-central1"
vertex_runtime_custom_role_id = "cloudRunVertexCaller"
vertex_runtime_custom_role_permissions = [
  "aiplatform.endpoints.predict",
]

cloud_run_cpu             = "1"
cloud_run_memory          = "2Gi"
cloud_run_concurrency     = 10
cloud_run_timeout_seconds = 300
cloud_run_min_instances   = 0
cloud_run_max_instances   = 3

cloud_run_container_port        = 8080
cloud_run_allow_unauthenticated = false
cloud_run_deletion_protection   = false

langfuse_base_url = "https://cloud.langfuse.com"
langfuse_debug    = "False"
langfuse_public_key = "pk-lf-xxxxxxxxxxxxxxxx"

gcs_models_timeout_seconds              = 60
gcs_models_upload_timeout_seconds       = 300
gcs_models_upload_retry_timeout_seconds = 900
gcs_models_upload_chunk_size_bytes      = 8388608

extra_plain_env_vars = {
  APP_ENV = "dev"
}

# Vertex auth uses the attached Cloud Run service account via ADC.
# Existing Secret Manager secrets only. Terraform will not create them here.
secret_env_vars = {
  LANGFUSE_SECRET_KEY = {
    secret_id = "langfuse-secret-key"
    version   = "latest"
  }
}

# Principals allowed to deploy Cloud Run with this runtime identity.
runtime_service_account_user_members = [
  "serviceAccount:terraform-deployer@your-gcp-project-dev.iam.gserviceaccount.com",
]

runtime_extra_project_roles = [
  "roles/firebaseauth.viewer",
  "roles/firebasedatabase.admin",
]

labels = {
  app = "causal-backend"
}
