project_id = "your-gcp-project-prod"
region     = "europe-west3"

environment = "prod"
name_prefix = "causal"

container_image = "europe-west3-docker.pkg.dev/your-gcp-project-prod/causal-prod-images/backend:prod"

firebase_database_region = "europe-west1"
firebase_database_type   = "DEFAULT_DATABASE"

allow_unauthenticated = false
deletion_protection   = true

extra_plain_env_vars = {
  APP_ENV = "prod"
}

secret_env_vars = {
  GEMINI_API_KEY = {
    secret_id = "gemini-api-key"
    version   = "latest"
  }
  LANGFUSE_SECRET_KEY = {
    secret_id = "langfuse-secret-key"
    version   = "latest"
  }
  LANGFUSE_PUBLIC_KEY = {
    secret_id = "langfuse-public-key"
    version   = "latest"
  }
}

labels = {
  app = "causal-backend"
}
