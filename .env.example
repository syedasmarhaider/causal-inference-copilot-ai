LOG_SERVICE_NAME=agent
LOG_LEVEL=INFO

# Vertex AI via Application Default Credentials.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# LLM provider. Supported: vertex_ai, google_ai_studio, openai, azure.
# Uncomment one provider block below. Vertex AI is the active default.

# --- Vertex AI (default) ---
# Uses Application Default Credentials plus VERTEXAI_PROJECT / VERTEXAI_LOCATION above.
LLM_PROVIDER=vertex_ai
LLM_MODEL_MINI=gemini-3.1-flash-lite-preview
LLM_MODEL_BASIC=gemini-3-flash-preview
LLM_MODEL_PRO=gemini-3-flash-preview
LLM_MODEL_THINKING=gemini-3.1-pro-preview

# --- Google AI Studio ---
# LLM_PROVIDER=google_ai_studio
# LLM_API_KEY=your-google-ai-studio-api-key
# LLM_MODEL_MINI=gemini-2.5-flash-lite
# LLM_MODEL_BASIC=gemini-2.5-flash
# LLM_MODEL_PRO=gemini-2.5-pro
# LLM_MODEL_THINKING=gemini-2.5-pro

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL_MINI=gpt-4.1-mini
# LLM_MODEL_BASIC=gpt-4.1
# LLM_MODEL_PRO=gpt-4.1
# LLM_MODEL_THINKING=o4-mini

# --- Azure OpenAI ---
# Model values are Azure deployment names, not base model names.
# LLM_PROVIDER=azure
# LLM_API_KEY=your-azure-openai-api-key
# LLM_API_BASE=https://your-resource-name.openai.azure.com
# LLM_API_VERSION=2024-10-21
# LLM_MODEL_MINI=your-mini-deployment
# LLM_MODEL_BASIC=your-basic-deployment
# LLM_MODEL_PRO=your-pro-deployment
# LLM_MODEL_THINKING=your-thinking-deployment

# Keep LiteLLM offline at import time; it will use its bundled model cost map.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Optional API runtime overrides.
API_HOST=0.0.0.0
API_PORT=8080

# SHAP companion node. SHAP calculations can take several minutes depending on available CPU.
SHAP_ENABLED=false

# random seed for experiment and reproduciblity
PRECISION_MEDICINE_RUN_SEED = none
