SERVICE_NAME=causal-inference-copilot-ai
GEMINI_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_DEBUG="False"

# TODO: add gcp emulator and firebase emulator later as currently is it just being mocked for testing
# make sure resouces like database and buckets are created in same project
# if using local files local data repo and models repo would be used instead of GCS, so these can be left blank in that case
USE_LOCAL_FILES="False" 
GOOGLE_CLOUD_PROJECT_ID=
GCS_MODELS_BUCKET_NAME=
GCS_DATA_BUCKET_NAME=
# Optional model artifact upload tuning (seconds/bytes)
GCS_MODELS_TIMEOUT_SECONDS=60
GCS_MODELS_UPLOAD_TIMEOUT_SECONDS=300
GCS_MODELS_UPLOAD_RETRY_TIMEOUT_SECONDS=900
GCS_MODELS_UPLOAD_CHUNK_SIZE_BYTES=8388608

# firebase is still needed as there is no local alternative for now
FIREBASE_DATABASE_URL=

# Optional structured logging config
LOG_LEVEL=INFO
